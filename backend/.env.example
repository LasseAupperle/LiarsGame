# Backend environment variables

PORT=3000
NODE_ENV=development

# Allowed browser origins, comma-separated. Unset or * = allow all (dev only).
CORS_ORIGIN=http://localhost:5173,https://your-site.netlify.app

# Optional timing overrides in ms (defaults shown, see docs/SPEC.md §2.1)
# GAME_GRACE_MS=120000
# LOBBY_GRACE_MS=60000
# AUTO_PLAY_MS=15000
